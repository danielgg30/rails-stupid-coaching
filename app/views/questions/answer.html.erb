<div class="container mt-5">
  <h1>Stupid Coaching</h1>

  <div class="border-start border-4 border-secondary ps-3 my-4">
    <p><%= @question %></p>
    <p class="text-secondary">— You</p>
  </div>

  <div class="border-start border-4 border-primary ps-3 my-4">
    <p><strong><%= @answer %></strong></p>
    <p class="text-secondary">— Your coach</p>
  </div>

  <%= link_to "Ask a new question", ask_path, class: "btn btn-primary" %>
</div>
